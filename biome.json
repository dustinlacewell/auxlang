{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "off"
      }
    }
  },
  "files": {
    "ignore": ["src/tests/core3/math/refs/*.json"]
  },
  "overrides": [
    {
      "include": ["src/core3/math/lib/**"],
      "linter": {
        "rules": {
          "correctness": { "noPrecisionLoss": "off" },
          "suspicious": { "noSelfCompare": "off", "noApproximativeNumericConstant": "off" },
          "style": { "useNumberNamespace": "off" }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "lineWidth": 100
  }
}
